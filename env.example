# Settings for xdadwal.in. Copy this file to `.env` (gitignored) and fill in the blank keys:
#   cp env.example .env
#
# Every value shown is the default. The app loads `.env` into the process environment at
# startup; variables already exported in your shell or set by systemd win over this file.

# --- Connection to OpenAI (read directly by logpose, never by the app) ----------------------
# The assistant is on only when all three are set. Leave the keys blank to keep it off.
LOGPOSE_BASE_URL=https://api.openai.com/v1
LOGPOSE_API_KEY=
# Key for the topic and safety check. logpose keeps it separate on purpose; for OpenAI it is
# the same key as LOGPOSE_API_KEY.
LOGPOSE_GUARD_API_KEY=

# --- Model and performance (read by the app; logpose has no variable for these) -------------
ASSISTANT_MODEL=gpt-6-luna
# How much the model thinks before answering: none, low, medium or high (the accepted values
# depend on the model). none suits this site's short lookups. Leave empty to send nothing.
ASSISTANT_REASONING_EFFORT=none
# Output ceiling per reply, in tokens; reasoning counts toward it. Replies so far used at most
# about 330, so this only stops runaway output.
ASSISTANT_MAX_OUTPUT_TOKENS=800
# The model's context window, in tokens. Change it whenever ASSISTANT_MODEL changes.
ASSISTANT_CONTEXT_WINDOW=1050000
# Input tokens one request may use before older turns of a long chat are summarized.
# Lower = cheaper long chats; it must stay above the size of the prompt itself
# (see `python -m scripts.show_context`).
ASSISTANT_CONTEXT_BUDGET=8000
# Seconds allowed for a whole reply, and for one model call within it.
ASSISTANT_RUN_TIMEOUT_SECONDS=30
ASSISTANT_TURN_TIMEOUT_SECONDS=20
# Seconds to open a connection to the model's API, and for the whole topic check. A check that
# times out lets the message through, and replies wait for the check, so keep it short.
ASSISTANT_CONNECT_TIMEOUT_SECONDS=2
ASSISTANT_GUARD_TIMEOUT_SECONDS=2.5

# --- OpenTelemetry tracing: the review log (read directly by logpose) -----------------------
# logpose records each conversation turn as an OpenTelemetry GenAI trace in its database;
# `python -m scripts.export_chats out.jsonl` writes them as OTLP/JSON for a collector.
# 1 = on. logpose's own default is off; this site turns both on.
LOGPOSE_TRACE=1
# 1 = also store the questions and answers; 0 = token counts and outcomes only.
LOGPOSE_TRACE_CONTENT=1
# SQLite file holding chats and traces. The systemd unit overrides this on the server.
LOGPOSE_DB_PATH=logpose.db
# SQLite file holding visitors' thumbs up/down on answers (read by the app; see
# `python -m scripts.show_feedback`). The systemd unit overrides this on the server.
ASSISTANT_FEEDBACK_DB_PATH=feedback.db

# --- Limits and retention (read by the app) -------------------------------------------------
# Days a chat, the visitor's cookie, its traces and its ratings are kept.
ASSISTANT_RETENTION_DAYS=30
# Messages one visitor may send per window, the window length in seconds, and the daily total
# for everyone. 0 turns a limit off: fine locally, but on the server the daily total is what
# caps your OpenAI bill.
ASSISTANT_RATE_LIMIT_PER_IP=20
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=600
ASSISTANT_RATE_LIMIT_PER_DAY=1000

# --- Local development ----------------------------------------------------------------------
# true lets the chat cookie work over plain http://localhost. Keep false on the server.
DEBUG=false
